# =============================================================================
#  Ichava Core — example environment configuration
# =============================================================================
#
#  Engine-only ICHAVA_* keys (database, cache, queue, logging, manifest, runtime).
#  HTTP-layer keys (ICHAVA_API_*, ICHAVA_VITE_DEV, ICHAVA_BROWSER_*,
#  ICHAVA_DOMAINS, ICHAVA_RATE_LIMITING_*, ICHAVA_MAX_REQUEST_SIZE) live in
#  ichava/browser's .env.example. Copy what you need from BOTH packages into
#  your application's .env.
#
#  Reference: github.com/ichava/documentation/docs/environment.md
#
# =============================================================================

# ----------------------------------------------------------------------------
# Identity / asset versioning
# ----------------------------------------------------------------------------
# Cache-busting token appended to published asset URLs. Defaults to time()
# at boot when unset; pin it to a build-tag in production.
ICHAVA_VERSION=

# ----------------------------------------------------------------------------
# PHP runtime tuning (heavy operations: seeding, batch processing)
# ----------------------------------------------------------------------------
ICHAVA_MEMORY_LIMIT=2G
ICHAVA_MAX_EXECUTION_TIME=0
ICHAVA_DISABLE_TELESCOPE_QUEUE=true
# Top-level guard read by SvgDriver before loading from disk (bytes).
ICHAVA_MAX_FILE_SIZE=2097152

# ----------------------------------------------------------------------------
# Database
# ----------------------------------------------------------------------------
ICHAVA_DATABASE_ENABLED=true
ICHAVA_AUTO_SYNC=true
ICHAVA_SYNC_INTERVAL=60
ICHAVA_AUTO_SEED=false
ICHAVA_USE_QUEUE=true
ICHAVA_QUEUE_CONNECTION=
ICHAVA_BATCH_SIZE=1000
ICHAVA_SMART_QUEUE_THRESHOLD=5000
# Search strategy: simple | multilingual | single
ICHAVA_SEARCH_STRATEGY=simple
ICHAVA_SEARCH_LANGUAGE=simple

# ----------------------------------------------------------------------------
# Manifest (production caching)
# ----------------------------------------------------------------------------
ICHAVA_MANIFEST_ENABLED=true
# Defaults to base_path('bootstrap/cache/ichava-manifest.php') when blank.
ICHAVA_MANIFEST_PATH=
ICHAVA_MANIFEST_AUTO_REBUILD=true

# ----------------------------------------------------------------------------
# Default + fallback icons
# ----------------------------------------------------------------------------
ICHAVA_DEFAULT_SET=test
# Fully-qualified icon path used when an icon can't be resolved and no
# per-component fallback is set. Leave blank to disable.
# Example: ichava/tabler-icons::outline/help
ICHAVA_FALLBACK_ICON=

# ----------------------------------------------------------------------------
# Route prefix (shared between core API + browser SPA)
# ----------------------------------------------------------------------------
# The /{prefix}/api/... and /{prefix}/icons URL namespace. Lives in core's
# config because core always exists; browser optionally consumes the same
# value if installed.
ICHAVA_BROWSER_PREFIX=ichava

# ----------------------------------------------------------------------------
# Blade components
# ----------------------------------------------------------------------------
ICHAVA_COMPONENTS_ENABLED=true

# ----------------------------------------------------------------------------
# Logging
# ----------------------------------------------------------------------------
ICHAVA_LOGGING_ENABLED=true
ICHAVA_LOG_CHANNEL=ichava
ICHAVA_SEEDING_LOG_CHANNEL=ichava-icons
ICHAVA_QUEUE_LOG_CHANNEL=ichava-queue
# Level: debug | info | warning | error
ICHAVA_LOG_LEVEL=warning
ICHAVA_SEEDING_LOG_LEVEL=info
ICHAVA_QUEUE_LOG_LEVEL=info
# Daily rotation retention.
ICHAVA_LOG_RETENTION_DAYS=7
ICHAVA_LOG_AUTO_CLEANUP=true
# 24h time-of-day for the daily cleanup task.
ICHAVA_LOG_CLEANUP_TIME=03:00
# Suppress duplicate log messages for this many seconds.
ICHAVA_LOG_DEDUP_TTL=300
# Optional debug toggles (only emitted when APP_DEBUG=true too).
ICHAVA_LOG_REQUESTS=false
ICHAVA_LOG_AUTH_DEBUG=false
ICHAVA_LOG_SESSION_DEBUG=false
ICHAVA_LOG_SECURITY=true
ICHAVA_LOG_PERFORMANCE=false
# Operations slower than this threshold (ms) get logged when LOG_PERFORMANCE=true.
ICHAVA_PERFORMANCE_THRESHOLD=200
# Override the directory Ichava writes its log files to. Defaults to
# storage_path('logs') — i.e. Laravel-standard. Accepts an absolute path or
# any path resolvable from the application root.
ICHAVA_LOG_PATH=

# ----------------------------------------------------------------------------
# Queue
# ----------------------------------------------------------------------------
ICHAVA_QUEUE_NAME=ichava-icons
ICHAVA_QUEUE_STAGGER_DELAY=2
ICHAVA_QUEUE_TIMEOUT=600
ICHAVA_QUEUE_RETRIES=3
ICHAVA_PROGRESS_TTL=86400

# ----------------------------------------------------------------------------
# Horizon supervisor (auto-registers when Horizon is installed)
# ----------------------------------------------------------------------------
ICHAVA_HORIZON_AUTO_REGISTER=true
ICHAVA_HORIZON_CONNECTION=redis
ICHAVA_HORIZON_BALANCE=simple
ICHAVA_HORIZON_MAX_PROCESSES=25
ICHAVA_HORIZON_MEMORY=256
