# Tag-driven. Every release carries a real description, extracted from that
# version's CHANGELOG section -- never auto-generated notes alone, which list
# commit subjects and explain nothing.
#
# A tag is the only legitimate `push` trigger in this ecosystem; everything else
# runs on `pull_request`.

name: Release

on:
  push:
    tags:
      - 'v*.*.*'
      - 'v*.*.*-*'

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  # Never cancel a release in flight. A half-published release is worse than a
  # queued one.
  cancel-in-progress: false

permissions:
  contents: write

jobs:
  release:
    name: Publish release
    runs-on: ubuntu-latest
    timeout-minutes: 30

    steps:
      - name: Checkout
        uses: actions/checkout@v7

      - name: Setup PHP
        uses: shivammathur/setup-php@f3e473d116dcccaddc5834248c87452386958240 # 2.37.2
        with:
          php-version: '8.5'
          extensions: dom, curl, libxml, mbstring, zip, fileinfo
          coverage: none

      - name: Install runtime dependencies
        env:
          COMPOSER_AUTH: '{"github-oauth":{"github.com":"${{ secrets.GITHUB_TOKEN }}"}}'
        run: composer install --no-dev --no-interaction --no-progress

      - name: Generate SBOM
        uses: anchore/sbom-action@3ad7283483fc7af8ff2b4ea19663c2d5ca935e26 # v0.24.2
        with:
          format: cyclonedx-json
          output-file: {{vendorKebab}}-{{kebabName}}-icons.cdx.json
          artifact-name: {{vendorKebab}}-{{kebabName}}-icons.cdx.json

      - name: Extract the changelog section
        id: changelog
        run: |
          set -euo pipefail
          VERSION="${GITHUB_REF_NAME#v}"

          SECTION="$(awk -v ver="$VERSION" '
            $0 ~ "^## \\[" ver "\\]" { found = 1; next }
            found && /^## \[/        { exit }
            found                    { print }
          ' CHANGELOG.md)"

          # Fail closed. A tag whose version has no CHANGELOG section is a tag
          # pointing at the wrong commit, or a release nobody wrote notes for --
          # both are reasons to stop, not to publish auto-generated notes and
          # call it a description.
          if [ -z "$(printf '%s' "$SECTION" | tr -d '[:space:]')" ]; then
            echo "::error::CHANGELOG.md has no '## [$VERSION]' section. Refusing to publish $GITHUB_REF_NAME."
            exit 1
          fi

          {
            echo 'body<<CHANGELOG_EOF'
            printf '%s\n' "$SECTION"
            echo ''
            echo "**Full changelog:** https://github.com/{{packageName}}/blob/main/CHANGELOG.md"
            echo 'CHANGELOG_EOF'
          } >> "$GITHUB_OUTPUT"

      - name: Publish
        uses: softprops/action-gh-release@efb35369e0ad2afab669f228072c1b0d510eae64 # v3.0.3
        with:
          body: ${{ steps.changelog.outputs.body }}
          generate_release_notes: true
          files: {{vendorKebab}}-{{kebabName}}-icons.cdx.json
