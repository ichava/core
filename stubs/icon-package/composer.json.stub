{
    "name": "{{packageName}}",
    "description": "{{humanName}} for Laravel via Ichava",
    "type": "library",
    "keywords": [
        "laravel",
        "blade",
        "icons",
        "svg",
        "{{kebabName}}",
        "ichava"
    ],
    "homepage": "https://github.com/{{packageName}}",
    "support": {
        "source": "https://github.com/{{packageName}}",
        "issues": "https://github.com/{{packageName}}/issues"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "{{vendor}}",
            "email": "{{email}}"
        }
    ],
    "require": {
        "php": "^8.3",
        "ichava/core": "^1.0",
        "illuminate/support": "^10.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^10.0|^11.0",
        "pestphp/pest": "^2.0|^3.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "{{namespaceEscaped}}\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "{{namespaceEscaped}}\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "{{namespaceEscaped}}\\Providers\\IconsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
