{
    "name": "{{packageName}}",
    "description": "{{humanName}} for Laravel via Ichava",
    "type": "library",
    "keywords": [
        "laravel",
        "blade",
        "icons",
        "svg",
        "{{kebabName}}",
        "ichava"
    ],
    "homepage": "https://github.com/{{packageName}}",
    "license": "MIT",
    "authors": [
        {
            "name": "{{vendor}}",
            "email": "{{email}}"
        }
    ],
    "require": {
        "php": "^8.4.1 || ^8.5",
        "illuminate/support": "^13.0",
        "ichava/core": "^0.2.5",
        "laranail/package-tools": "^0.1.0"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/ichava/core"
        },
        {
            "type": "vcs",
            "url": "https://github.com/laranail/package-tools.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/laranail/console.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/laranail/enumerator.git"
        }
    ],
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.6 || ^5.0",
        "phpstan/phpstan": "^2.1",
        "laravel/pint": "^1.18"
    },
    "autoload": {
        "psr-4": {
            "{{namespaceEscaped}}\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "{{namespaceEscaped}}\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "{{namespaceEscaped}}\\Providers\\IconsServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "scripts": {
        "pint": "@php vendor/bin/laranail-pint --test",
        "pint-fix": "@php vendor/bin/laranail-pint --parallel",
        "lint": "@pint",
        "format": "@pint-fix",
        "test": "vendor/bin/pest --parallel",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=2G"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "support": {
        "source": "https://github.com/{{packageName}}",
        "issues": "https://github.com/{{packageName}}/issues",
        "security": "https://github.com/{{packageName}}/security/policy"
    }
}
